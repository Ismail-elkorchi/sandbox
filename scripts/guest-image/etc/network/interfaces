auto lo
iface lo inet loopback

# This is ordinary, administrator-editable Linux configuration. External
# authority is enforced by the native NIC gateway, not by this file or init.
auto eth0
iface eth0 inet static
    address 100.64.0.2
    netmask 255.255.255.252
    gateway 100.64.0.1
iface eth0 inet6 static
    address fd00::2
    netmask 64
    gateway fd00::1
