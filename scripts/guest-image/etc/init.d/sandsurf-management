#!/sbin/openrc-run
description="Optional Sandsurf execution and filesystem management"
supervisor="supervise-daemon"
command="/usr/sbin/sandsurf-guest"
output_log="/var/log/sandsurf-management.log"
error_log="/var/log/sandsurf-management.log"
respawn_delay=1

depend() {
    need localmount sandsurf-clone-identity
}

start_pre() {
    # Firecracker uses vsock; hardware-accelerated QEMU uses virtio-serial.
    # Both are ordinary Linux device drivers, independent of machine power.
    modprobe virtio_console || return 1
}
