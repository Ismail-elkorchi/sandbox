<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.sandsurf.network</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/libexec/sandsurf/sandsurf-host-macos-@ARCH@</string>
    <string>--native-network-sockets</string>
  </array>
  <key>UserName</key><string>root</string>
  <key>GroupName</key><string>wheel</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>1</integer>
  <key>ExitTimeOut</key><integer>3</integer>
  <key>HardResourceLimits</key><dict>
    <key>NumberOfFiles</key><integer>128</integer>
    <key>Core</key><integer>0</integer>
  </dict>
</dict></plist>
