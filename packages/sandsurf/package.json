{
  "name": "sandsurf",
  "version": "1.0.0",
  "description": "Persistent hardware-isolated Linux environments for autonomous agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-elkorchi/sandbox.git",
    "directory": "packages/sandsurf"
  },
  "homepage": "https://github.com/Ismail-elkorchi/sandbox#readme",
  "bugs": {
    "url": "https://github.com/Ismail-elkorchi/sandbox/issues"
  },
  "keywords": [
    "machine",
    "isolation",
    "security",
    "nodejs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sandsurf": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native",
    "images/**/*.json",
    "images/**/boot-*",
    "images/**/*.gz",
    "images/development-*/source-materials/**",
    "LICENSE",
    "SBOM.cdx.json",
    "THIRD-PARTY"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {}
}
